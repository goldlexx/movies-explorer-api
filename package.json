{
  "name": "movies-explorer-api",
  "version": "1.0.0",
  "description": "Movies Explorer API running on Cloudflare Workers and D1",
  "main": "app.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
